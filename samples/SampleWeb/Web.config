<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <connectionStrings>
    <!-- Default: SQL Server LocalDB (installed with Visual Studio). The sample creates the
         database and table on first run. -->
    <add name="SessionState"
         providerName="System.Data.SqlClient"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=ArkSessionSample;Integrated Security=True" />

    <!-- Oracle (add the Oracle.ManagedDataAccess NuGet package to SampleWeb.csproj):
    <add name="SessionState"
         providerName="Oracle.ManagedDataAccess.Client"
         connectionString="User Id=SESSION_USER;Password=...;Data Source=host:1521/ORCLPDB1" />
    -->

    <!-- PostgreSQL (add Npgsql, and providerFactoryType="Npgsql.NpgsqlFactory, Npgsql" below):
    <add name="SessionState"
         providerName="Npgsql"
         connectionString="Host=localhost;Database=sessions;Username=app;Password=..." />
    -->
  </connectionStrings>

  <appSettings>
    <!-- Sample only: create the session table on startup if it doesn't exist. -->
    <add key="Sample:CreateSchema" value="true" />
  </appSettings>

  <!-- Register ADO.NET drivers that aren't in machine.config, so providerName can find them.
       (SqlClient, ODBC and OLE DB are always registered.) -->
  <system.data>
    <DbProviderFactories>
      <remove invariant="Oracle.ManagedDataAccess.Client" />
      <add name="ODP.NET, Managed Driver" invariant="Oracle.ManagedDataAccess.Client"
           description="Oracle Data Provider for .NET, Managed Driver"
           type="Oracle.ManagedDataAccess.Client.OracleClientFactory, Oracle.ManagedDataAccess" />
    </DbProviderFactories>
  </system.data>

  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
    <customErrors mode="Off" />

    <sessionState mode="Custom" customProvider="DbSessionState" timeout="20">
      <providers>
        <!-- cleanupInterval="1" sweeps expired rows every minute so it's easy to watch. -->
        <add name="DbSessionState"
             type="Ark.SessionState.AdoNet.DbSessionStateStore, Ark.SessionState.AdoNet"
             connectionStringName="SessionState"
             cleanupInterval="1" />
      </providers>
    </sessionState>
  </system.web>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <handlers>
      <add name="SessionApi" path="api/session" verb="*" type="SampleWeb.SessionApiHandler, SampleWeb" />
      <add name="SessionApiReadOnly" path="api/readonly" verb="*" type="SampleWeb.ReadOnlySessionHandler, SampleWeb" />
      <add name="SessionRows" path="api/rows" verb="*" type="SampleWeb.SessionRowsHandler, SampleWeb" />
    </handlers>
  </system.webServer>

</configuration>
